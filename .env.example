# ProofMarket — environment variables
# Copy this file to .env and fill in your values.

# ── Primus ────────────────────────────────────────────────────────────────────
# App ID — bundled into the browser bundle by Vite (safe to expose)
VITE_APP_ID=

# App Secret — backend/server only. NEVER prefix with VITE_ or it will be
# leaked into the browser bundle.
APP_SECRET=

# ── Payments ──────────────────────────────────────────────────────────────────
# Sepolia ETH receiver address — where testnet ETH payments are sent.
# Also exposed to the browser so the UI can call sendTransaction() with it.
VITE_RECEIVER_ADDRESS=

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Provision a Redis database on Upstash (https://upstash.com) or via the
# Vercel Marketplace integration, then paste the REST URL and token below.
# These are server-only vars — do NOT prefix with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
